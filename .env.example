AI_API_BASE_URL=https://your-ai-provider.example/v1
AI_API_KEY=replace-with-a-server-side-api-key
AI_MODEL=replace-with-your-model-id
PORT=3000

# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-bytes

# Never enable this for a real firm or production customer environment.
FINOVA_DEMO_MODE=false

# Supabase Production Database Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
